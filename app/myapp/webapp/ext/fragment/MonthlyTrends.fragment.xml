<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"
    xmlns:viz="sap.viz.ui5.controls"
        xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">
    <m:Dialog title="Monthly Trends" contentWidth="800px" contentHeight="auto" core:require="{handler: 'myapp/ext/controller/EmployeeAnalytics'}">
        <l:FixFlex class="sapUiMediumMargin" minFlexSize="250">
        <l:flexContent>
            <viz:VizFrame uiConfig="{applicationSet:'fiori'}" height='100%' width="100%" vizType='line' vizProperties="{title:{text:'Visual representation of monthly timesheet hours trend', visible:'true'},plotArea:{dataLabel :{visible: true}}}">
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{/TimesheetMonthlyAnalytics}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Month" value="{month}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Total Hours" value="{path: 'totalHours'}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Total Hours" />
                    <viz.feeds:FeedItem  uid="categoryAxis" type="Dimension" values="Month" />
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover ></viz:Popover>
                </viz:dependents>
            </viz:VizFrame>
        </l:flexContent>

    </l:FixFlex>
        <m:buttons>
            <m:Button text="Close" press="handler.onCancelMonthlyTrends"/>
        </m:buttons>
    </m:Dialog>
</core:FragmentDefinition>