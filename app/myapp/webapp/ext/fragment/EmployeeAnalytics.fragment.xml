<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:m="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"
    xmlns:viz="sap.viz.ui5.controls"
        xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">
    <m:Dialog id="purchasingAccessDataDialog" title="Employee Analytics" contentWidth="800px" contentHeight="auto" core:require="{handler: 'myapp/ext/controller/EmployeeAnalytics'}">
        <l:FixFlex id='chartFixFlex' class="sapUiMediumMargin" minFlexSize="250">
        <l:flexContent>
            <viz:VizFrame id="idVizFrame" uiConfig="{applicationSet:'fiori'}" height='100%' width="100%" vizType='column' vizProperties="{title:{text:'Visual representation of total hours logged by employees', visible:'true'},plotArea:{dataLabel :{visible: true}}}">
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{/TimesheetAnalytics}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Employee Name" value="{employeeName}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Total Hours" value="{path: 'totalHours'}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem id='valueAxisFeed2' uid="valueAxis" type="Measure" values="Total Hours" />
                    <viz.feeds:FeedItem id='categoryAxisFeed' uid="categoryAxis" type="Dimension" values="Employee Name" />
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover id="idPopOver"></viz:Popover>
                </viz:dependents>
            </viz:VizFrame>
        </l:flexContent>

    </l:FixFlex>
        <m:buttons>
            <m:Button text="Close" press="handler.onCancel"/>
        </m:buttons>
    </m:Dialog>
</core:FragmentDefinition>