{
  "name": "timesheet",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "cds-numberrange-plugin": "^1.0.1",
    "express": "^4",
    "nodemailer": "^8.0.6"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana",
        "pool": {
          "min": 100,
          "max": 1800,
          "evictionRunIntervalMillis": 60000,
          "acquireTimeoutMillis": 10000,
          "numTestsPerEvictionRun": 500,
          "softIdleTimeoutMillis": 30000,
          "idleTimeoutMillis": 30000,
          "testOnBorrow": true,
          "fifo": true
        }
      },
      "[development]": {
        "auth": {
          "strategy": "mock",
          "users": {
            "gowthaminagineni27@gmail.com": {
              "password": "Gowthami",
              "roles": [
                "authenticated-user",
                "Manager"
              ]
            }
          }
        }
      },
      "[hybrid]": {
        "auth": {
          "kind": "xsuaa",
          "strategy": "xsuaa"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "connectivity": true,
      "destinations": true
    },
    "cds-numberrange-plugin": {
      "ranges": [
        {
          "name": "ACT_RANGE",
          "start": 1,
          "increment": 1,
          "createOnDraft": true,
          "additionalProperties": {
            "prefix": "ACT-",
            "padCount": 4,
            "padValue": "0"
          }
        }
      ]
    }
  },
  "scripts": {
    "start": "cds-serve",
    "watch-timesheet": "cds watch --open timesheet/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-myapp": "cds watch --open myapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy timesheet --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/timesheet",
    "app/myapp"
  ]
}
